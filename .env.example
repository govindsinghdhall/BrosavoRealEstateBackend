NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/realestate_crm
JWT_SECRET=dev-only-change-in-production-32chars
JWT_EXPIRES_IN=7d
# Comma-separated frontend URLs (no trailing slashes)
CORS_ORIGIN=http://localhost:5173,http://localhost:5175,https://crm.durgaproperty.com
# WhatsApp Graph API settings
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v17.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
# Public website tenancy is per-request (x-website-api-key and/or organizationId).
# PUBLIC_ORGANIZATION_SLUG is unused by /api/v1/public/* and must not be used as a fallback.
# PUBLIC_ORGANIZATION_SLUG=durga-property
# Marketing Hub — Google Business OAuth (optional until you connect Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_BASE_URL=https://brisavorealestatebackend-1.onrender.com
GOOGLE_REDIRECT_URI=https://brisavorealestatebackend-1.onrender.com/api/v1/marketing/google/callback
FRONTEND_URL=https://crm.durgaproperty.com
MARKETING_UPLOAD_DIR=uploads/marketing

# Cloudflare R2 Configuration
# Required for property image uploads
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# Optional - only if using a custom domain instead of the default R2 endpoint
# CLOUDFLARE_R2_PUBLIC_URL=

CLOUDFLARE_R2_ACCOUNT_ID=572f6844bd862d131bec5d113b11f87a
CLOUDFLARE_R2_ACCESS_KEY_ID=db07d5ba4974b59a7dd8964b6c24093a
CLOUDFLARE_R2_SECRET_ACCESS_KEY=2a7295e99977e3e63b851a6eca89f45f955c24b4f7e2b6e8f1936ecf72c57ed2
CLOUDFLARE_R2_BUCKET_NAME=brosavo-property-images
CLOUDFLARE_R2_ENDPOINT=https://572f6844bd862d131bec5d113b11f87a.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-f23b8de389f94508b57578c78a1476f4.r2.dev


# Server
# NODE_ENV=development
# PORT=4000
# API_BASE_URL=http://localhost:4000
# FRONTEND_URL=http://localhost:3000

# Database
# MONGODB_URI=mongodb://localhost:27017/brisavo

# Security
# JWT_SECRET=your-super-secret-jwt-key-change-this
# JWT_EXPIRES_IN=7d
# Exactly 64 hex chars (32 bytes). Keep stable across restarts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta WhatsApp (server-only — never put these in VITE_* frontend env)
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_CLIENT_ID=your_meta_app_id
WHATSAPP_CLIENT_SECRET=your_meta_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_REDIRECT_URI=http://localhost:4000/api/v1/whatsapp/callback
ENCRYPTION_KEY=generate_64_hex_chars

# Optional aliases (same values as above if you prefer META_* names)
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_API_VERSION=v26.0
# META_WEBHOOK_VERIFY_TOKEN=
# META_OAUTH_REDIRECT_URI=
# META_ENCRYPTION_KEY=

