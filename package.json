{
  "name": "realestate-backend",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS API for RealEstate CRM and public websites",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "render:build": "npm install --include=dev && npm run build",
    "seed": "tsx src/scripts/seed.ts",
    "test": "tsx --test src/services/publicTenant.service.test.ts src/services/whatsapp.payload.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "realestate",
    "crm",
    "saas",
    "mongodb"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.2",
    "morgan": "^1.11.0",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
